<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.metalexplorer.mapper.ArtistTagMapper">

    <select id="findByArtistIdOrderByWeightDesc" resultType="com.metalexplorer.domain.artist.ArtistTag">
        SELECT artist_id, tag_name, weight
        FROM artist_tags
        WHERE artist_id = #{artistId}
        ORDER BY weight DESC
    </select>

    <delete id="deleteByArtistId">
        DELETE FROM artist_tags WHERE artist_id = #{artistId}
    </delete>

    <insert id="batchInsert">
        INSERT INTO artist_tags (artist_id, tag_name, weight)
        VALUES
        <foreach collection="list" item="tag" separator=",">
            (#{tag.artistId}, #{tag.tagName}, #{tag.weight})
        </foreach>
    </insert>

</mapper>
